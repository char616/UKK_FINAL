{
  "info": {
    "name": "SCP2 System REST API Collection",
    "description": "Koleksi lengkap pengujian API School Class Progress (SCP2) termasuk Test Email OTP, Notifikasi Kehadiran, Login, Jadwal, Presensi, Izin/Sakit, dan Jurnal Mengajar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    }
  ],
  "item": [
    {
      "name": "1. Cek Status Server (Health Check)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "2. Login Pengguna",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login_key\": \"WAKA001\",\n  \"password\": \"password123\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "3. Test Kirim Email OTP Reset Password",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"target.pengujian@gmail.com\",\n  \"login_key\": \"WAKA001\",\n  \"name\": \"Bapak Waka Kurikulum\"\n}"
        },
        "url": "{{base_url}}/mail/test-otp"
      }
    },
    {
      "name": "4. Test Kirim Email Notifikasi Kehadiran Siswa",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"orangtua.siswa@gmail.com\",\n  \"recipient_name\": \"Budi Santoso (Orang Tua)\",\n  \"student_name\": \"Ahmad Fauzi\",\n  \"class_name\": \"10 RPL 1\",\n  \"subject_name\": \"Pemrograman Berorientasi Objek\",\n  \"date\": \"2026-10-31\",\n  \"status\": \"Sakit\"\n}"
        },
        "url": "{{base_url}}/mail/test-attendance"
      }
    },
    {
      "name": "5. Daftar Master Data (Kelas & Mapel)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{base_url}}/master-data"
      }
    },
    {
      "name": "6. Daftar Jadwal Pelajaran",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{base_url}}/schedules"
      }
    },
    {
      "name": "7. Daftar Presensi Siswa",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{base_url}}/attendances"
      }
    },
    {
      "name": "8. Daftar Pengajuan Izin & Sakit",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{base_url}}/leaves"
      }
    },
    {
      "name": "9. Ajukan Izin / Sakit (Siswa atau Orang Tua)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"actor_login_key\": \"2026100001\",\n  \"type\": \"Sakit\",\n  \"start_date\": \"2026-10-31\",\n  \"end_date\": \"2026-11-01\",\n  \"reason\": \"Demam dan istirahat sesuai surat dokter\"\n}"
        },
        "url": "{{base_url}}/leaves"
      }
    },
    {
      "name": "10. Daftar Jurnal Mengajar Guru",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{base_url}}/journals"
      }
    }
  ]
}

